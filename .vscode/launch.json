{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NestJS: debug local app",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "-r",
        "ts-node/register",
        "-r",
        "tsconfig-paths/register"
      ],
      "args": ["${workspaceFolder}/src/main.ts"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.local",
      "env": {
        "APP_ENV": "local"
      },
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "NestJS: attach to npm run start:debug",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Jest: debug current file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": ["--runTestsByPath", "${file}", "--runInBand"],
      "cwd": "${workspaceFolder}",
      "env": {
        "APP_ENV": "test",
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/nestjs_modular_prisma_sample",
        "JWT_ACCESS_TOKEN_SECRET": "test-jwt-access-token-secret"
      },
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
